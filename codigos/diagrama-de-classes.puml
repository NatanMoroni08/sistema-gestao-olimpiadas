@startuml
' Definição do título do diagrama
title Diagrama de Classes - SGO

class Pais {
  -id: Long
  -nome: String
  -sigla: String
}

class Atleta {
  -id: Long
  -nome: String
  -dataNascimento: Date
  +inscrever(competicao: Competicao): void
  +getInscricoes(): List<Inscricao>
}

class Modalidade {
  -id: Long
  -nome: String
}

class Local {
  -id: Long
  -nome: String
  -capacidade: Integer
  +verificarDisponibilidade(data: DateTime, horario: Time): boolean
}

class Competicao {
  -id: Long
  -data: DateTime
  -horario: Time
  +adicionarInscricao(inscricao: Inscricao): void
  +alocarLocal(local: Local): void
  +registrarResultado(resultado: Resultado): void
}

class Inscricao {
  -dataInscricao: DateTime
  -status: String
  +confirmar(): void
  +cancelar(): void
}

class Resultado {
  -posicao: Integer ' 1=Ouro, 2=Prata, 3=Bronze
  -marca: String ' Ex: tempo, pontos
}

' --- Relacionamentos ---

' Um Atleta representa um País.
Atleta "*" --> "1" Pais

' Uma Competição é de uma Modalidade e ocorre em um Local.
Competicao "*" --> "1" Modalidade
Competicao "*" --> "1" Local

' A relação N-N entre Atleta e Competição é mediada pela classe de associação Inscricao.
Atleta "1" --> "0..*" Inscricao
Competicao "1" --> "0..*" Inscricao

' Um Resultado pertence a uma Competição e a um Atleta.
Resultado "*" --> "1" Competicao
Resultado "*" --> "1" Atleta

@enduml